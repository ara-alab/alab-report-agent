# 로컬 개발 환경변수 — .env 로 복사해 사용, Next 앱과 compose.dev.yml 이 함께 읽음

# ── MES DB(MariaDB) — compose.dev.yml 초기화 값과 앱 접속 값 공용
ALAB_DB_HOST=127.0.0.1
ALAB_DB_PORT=13316
ALAB_DB_NAME=mes
ALAB_DB_ROOT_PASSWORD=alab-dev-root
# 앱 전용 계정 — 보고서 저장 등 쓰기용
ALAB_DB_APP_USER=alab_app
ALAB_DB_APP_PASSWORD=alab-dev-app
# Agent 조회 전용 계정 — SELECT 권한만 보유
ALAB_DB_RO_USER=alab_ro
ALAB_DB_RO_PASSWORD=alab-dev-ro

# ── LLM(Anthropic) — 모델 값은 비우면 src/lib/llm/client.ts 기본값 사용
ANTHROPIC_API_KEY=
ALAB_PREMIUM_MODEL=
ALAB_EDIT_MODEL=
ALAB_EDIT_MODEL_HEAVY=
ALAB_FILL_MODEL=
ALAB_EDIT_EFFORT=
ALAB_EDIT_EFFORT_HEAVY=
# 1 이면 대형 요청 전 모델 문맥 한도 사전 점검
ALAB_AI_CAPACITY_CHECK=
